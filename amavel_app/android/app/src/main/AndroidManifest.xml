<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Audio recording permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Audio settings modification -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Wake lock permission for background services -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Boot completed receiver for app initialization -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service for audio processing -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Post notifications (required for Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network state access -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Feature declarations -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:label="AMAVEL"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boot completed receiver for background operations -->
        <receiver
            android:name=".BootCompleteReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service declaration for audio processing -->
        <service
            android:name=".AudioProcessingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Flutter-specific configuration -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- API key configuration via meta-data (for --dart-define support) -->
        <meta-data
            android:name="openai_api_key"
            android:value="@string/openai_api_key" />
        <meta-data
            android:name="anthropic_api_key"
            android:value="@string/anthropic_api_key" />
        <meta-data
            android:name="google_cloud_key"
            android:value="@string/google_cloud_key" />
        <meta-data
            android:name="azure_speech_key"
            android:value="@string/azure_speech_key" />

    </application>

</manifest>
