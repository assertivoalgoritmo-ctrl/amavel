rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth.uid == uid;
    }

    function isFamilyMember(seniorUid) {
      let isMember = false;
      let seniorDoc = get(/databases/{database}/documents/users/{seniorUid});

      if (seniorDoc.exists) {
        let familyMembers = seniorDoc.data.familyMembers;
        if (familyMembers != null) {
          isMember = request.auth.uid in familyMembers;
        }
      }

      return isMember;
    }

    function getRelationship(seniorUid) {
      let seniorDoc = get(/databases/{database}/documents/users/{seniorUid});

      if (seniorDoc.exists && seniorDoc.data.familyMembers != null) {
        let familyMember = seniorDoc.data.familyMembers[request.auth.uid];
        if (familyMember != null) {
          return familyMember.relationship;
        }
      }

      return null;
    }

    // Users collection: Each user has their own profile
    match /users/{uid} {
      allow read: if isUser(uid) || isFamilyMember(uid);
      allow create: if isUser(uid);
      allow update, delete: if isUser(uid);

      // Subcollections
      match /conversations/{conversationId} {
        allow read, write: if isUser(uid);
      }

      match /memoryFacts/{factId} {
        allow read, write: if isUser(uid);
      }

      match /alerts/{alertId} {
        allow read: if isUser(uid) || isFamilyMember(uid);
        allow create, update: if isUser(uid);
        allow delete: if isUser(uid);
      }

      match /messages/{messageId} {
        allow read: if isUser(uid) ||
                      (isAuthenticated() && request.auth.uid == resource.data.recipientId);
        allow create: if isUser(uid);
        allow update: if isUser(uid) ||
                        (isAuthenticated() && request.auth.uid == resource.data.recipientId);
      }

      match /settings/{document=**} {
        allow read, write: if isUser(uid);
      }

      match /dataRetention/{document=**} {
        allow read, write: if isUser(uid);
      }

      match /wellnessReports/{reportId} {
        allow read: if isUser(uid) || isFamilyMember(uid);
        allow write: if isUser(uid);
      }
    }

    // App configuration (readable by all authenticated users)
    match /config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // System documents (admin only)
    match /system/{document=**} {
      allow read, write: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
