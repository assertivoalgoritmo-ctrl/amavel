rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user exists in Firestore
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth.uid == uid;
    }

    function isFamilyMember(seniorUid) {
      return exists(/databases/(default)/documents/users/{seniorUid}/familyMembers/{request.auth.uid});
    }

    // Audio files for conversations
    // Structure: audio/{userId}/conversations/{conversationId}/{fileId}
    match /audio/{userId}/conversations/{allPaths=**} {
      allow read, write: if isUser(userId) || isFamilyMember(userId);
    }

    // User profile images
    // Structure: images/{userId}/profile/{fileName}
    match /images/{userId}/profile/{fileName} {
      allow read: if isUser(userId) || isFamilyMember(userId);
      allow write: if isUser(userId) &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Memory attachments
    // Structure: memories/{userId}/{fileName}
    match /memories/{userId}/{fileName} {
      allow read, write: if isUser(userId);
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }

    // Temporary uploads
    // Structure: temp/{userId}/{fileName}
    match /temp/{userId}/{fileName} {
      allow read, write: if isUser(userId);
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
